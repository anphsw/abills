{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier for the document"
    },
    "uid": {
      "type": "integer",
      "description": "User ID who owns the document"
    },
    "doc_type": {
      "type": "integer",
      "description": "Document type (passport, ID card, driver license, etc.)"
    },
    "num": {
      "type": "string",
      "description": "Document number"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Document issue date (YYYY-MM-DD)"
    },
    "expire": {
      "type": "string",
      "format": "date",
      "description": "Document expiration date (YYYY-MM-DD)"
    },
    "issued_by": {
      "type": "string",
      "description": "Authority that issued the document"
    },
    "filename": {
      "type": "string",
      "description": "Attached file name"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Record creation timestamp"
    }
  },
  "required": [
    "id",
    "uid",
    "doc_type",
    "num",
    "date",
    "created_at"
  ]
}