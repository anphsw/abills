#!/usr/bin/expect

if { $argc < 3 } {
  puts "Usage: mx80.backup <ip> <login> <password>"
  exit 1
}

set ip [lindex $argv 0]
set login [lindex $argv 1]
set password [lindex $argv 2]
set port [lindex $argv 3]

set timeout 60

if { $port ne "" } {
  spawn ssh $login@$ip -p $port
} else {
  spawn ssh $login@$ip
}

expect "assword:"
send "$password\r"

expect "$login>"

#log_file -a "backup_$ip.txt"
send "show configuration | no-more\r"

expect "$login>"
#log_file
send "exit\r"
expect eof

#expect "*%"
#send "exit\r"
