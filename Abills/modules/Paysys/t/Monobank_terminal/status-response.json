{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference Schema",
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "pattern": "^[0-9#]+$"
    },
    "paymentCreated": {
      "type": "boolean"
    }
  },
  "required": ["reference", "paymentCreated"]
}