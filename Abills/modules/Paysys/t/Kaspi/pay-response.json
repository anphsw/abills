{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transaction Response",
  "type": "object",
  "properties": {
    "comment": {
      "type": "string",
      "description": "Response comment or message"
    },
    "prv_txn": {
      "type": "integer",
      "description": "Previous transaction ID"
    },
    "result": {
      "type": "integer",
      "description": "Result code"
    },
    "sum": {
      "type": "number",
      "description": "Transaction amount"
    },
    "txn_id": {
      "type": "integer",
      "description": "Current transaction ID"
    }
  },
  "required": [
    "comment",
    "prv_txn",
    "result",
    "sum",
    "txn_id"
  ],
  "additionalProperties": false
}