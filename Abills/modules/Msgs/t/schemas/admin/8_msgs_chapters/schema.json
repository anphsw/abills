{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "The Root Schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "responsible": {
        "type": "integer"
      },
      "innerChapter": {
        "type": "integer"
      },
      "autoclose": {
        "type": "integer"
      }
    },
    "required": [
